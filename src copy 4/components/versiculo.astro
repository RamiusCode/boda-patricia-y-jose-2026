---
---
<div class="tarjeta-versiculo w-full">
  <div class="fondo-palorosa shadow-xl overflow-hidden">
    <div class="px-4 py-6 text-center">

      <div class="flex items-center gap-2 mb-3">
        <div class="flex-1 h-px bg-[#c98d88]"></div>
        <span class="text-[#c98d88] text-[10px]">✦</span>
        <div class="flex-1 h-px bg-[#c98d88]"></div>
      </div>

      <p class="font-cormorant text-sm text-[#122a4d] leading-relaxed italic">
        "Los tiempos de Dios son perfectos"
      </p>

      <div class="flex items-center gap-2 mt-3">
        <div class="flex-1 h-px bg-[#c98d88]"></div>
        <span class="text-[#c98d88] text-[10px]">✦</span>
        <div class="flex-1 h-px bg-[#c98d88]"></div>
      </div>

      <p class="font-cormorant text-sm text-[#a35f5a] mt-2">Eclesiastés 3:1</p>

    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  gsap.fromTo(".tarjeta-versiculo",
    { opacity: 0, y: 40 },
    { opacity: 1, y: 0, duration: 1, ease: "power3.out",
      scrollTrigger: { trigger: ".tarjeta-versiculo", start: "top 90%", toggleActions: "play none none reset" }
    }
  );
</script>
