---
---
<div class="tarjeta-recepcion w-full relative">
  <img
    src="/imagenes/hojaslateral.png"
    alt="Hojas decorativas"
    class="absolute -top-24 -left-2 w-[130px] object-contain z-0"
  />
  <div class="fondo-palorosa shadow-xl overflow-hidden relative z-10" style="border-radius: 90px 90px 0 0;">
    <div class="px-3 pt-8 pb-6 text-center">

      <div class="flex justify-center mb-2">
        <img src="/iconos/recepcion.png" alt="Recepción" class="w-10 h-10 object-contain azul-filter" />
      </div>

      <h2 class="font-cormorant text-xl text-[#122a4d] uppercase font-semibold mb-1">Recepción Social</h2>

      <p class="font-cormorant text-base text-[#a35f5a] font-semibold leading-tight mb-1">Salón de Eventos<br/>Bonaterra</p>

      <div class="flex items-center gap-2 mb-2">
        <div class="flex-1 h-px bg-[#c98d88]"></div>
        <span class="text-[#c98d88] text-[10px]">✦</span>
        <div class="flex-1 h-px bg-[#c98d88]"></div>
      </div>

      <p class="font-cormorant text-sm text-[#122a4d] leading-tight mb-1">Calle Urkupiña entre Cincinato Prado y J. Rossendy</p>
      <p class="font-cormorant text-sm text-[#a35f5a] font-semibold tracking-[0.15em] mb-4">15:00</p>

      <a href="https://maps.app.goo.gl/cG6s5kqq1bEZxSuD9" target="_blank"
        class="inline-flex items-center gap-1.5 bg-[#1b3a63] text-[#e3b7b3] font-cormorant text-xs uppercase px-6 py-2 rounded-full hover:bg-[#1b3a63]/90 transition-colors">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        Ubicación
      </a>

    </div>
  </div>
</div>

<style>
  .azul-filter {
    filter: brightness(0) saturate(100%) invert(13%) sepia(76%) saturate(684%) hue-rotate(180deg) brightness(100%) contrast(98%);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  gsap.fromTo(".tarjeta-recepcion",
    { opacity: 0, y: 40 },
    { opacity: 1, y: 0, duration: 1, ease: "power3.out",
      scrollTrigger: { trigger: ".tarjeta-recepcion", start: "top 90%", toggleActions: "play none none reset" }
    }
  );
</script>
