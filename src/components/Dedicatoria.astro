---
// Componente Dedicatoria - Diseño sobre con card y fotos polaroid
export interface Props {
  invitado?: string;
  pases?: number;
}
const { invitado, pases } = Astro.props;
// Sin nombre de invitado la invitación es genérica: se oculta el bloque
// personal y la frase cierra en "matrimonio."
const personalizada = Boolean(invitado);
const etiquetaPases = pases === 1 ? "pase" : "pases";
---

<section
  id="dedicatoria"
  class="relative w-full pt-2 pb-16 md:pb-24 flex flex-col items-center justify-center overflow-hidden z-[0]"
>
  <div
    class="dedicatoria-container relative w-full max-w-[320px] sm:max-w-sm mx-auto px-4"
  >
    <!-- Sobre (queda detrás del card) -->
    <div class="relative z-0">
      <img
        src="/imagenes/sobre2.png"
        alt="Sobre de invitación"
        class="sobre-img w-full block object-contain drop-shadow-2xl"
      />
    </div>

    <!-- Card + Sello: empieza a mitad del sobre, alineado a la derecha -->
    <div class="card-wrapper relative -mt-[8%] ml-auto w-[88%] z-10">
      <!-- Sello centrado en el borde superior del card -->
      <div class="sello-wrapper absolute -top-7 left-1/2 -translate-x-1/2 z-20">
        <img
          src="/imagenes/boton.png"
          alt="Sello"
          class="sello-img w-16 h-16 object-contain drop-shadow-lg"
        />
      </div>

      <!-- Card blanco transparente -->
      <div
        class="card-content bg-[#fff0ed]/45 backdrop-blur-none shadow-2xl px-6 pt-12 pb-16 text-center border border-[#e3b7b3]/30"
      >
        {
          personalizada && (
            <Fragment>
              {/* Invitado */}
              <p class="bloque-invitado font-cormorant text-[17px] leading-none text-[#122a4d]">
                Estimado(a):
              </p>
              <p
                id="nombre-invitado"
                class="bloque-invitado font-great-vibes text-[30px] leading-[1.35] whitespace-nowrap text-[#a35f5a] mt-1"
              >
                {invitado}
              </p>

              <div class="linea-deco w-14 h-[1px] bg-[#c98d88]/60 mx-auto my-3" />
            </Fragment>
          )
        }

        <!-- Texto invitación -->
        <p
          class="texto-invitacion font-cormorant text-[15px] text-[#122a4d] leading-relaxed"
        >
          Con la bendición de nuestros padres te invitamos a celebrar nuestra
          unión en matrimonio{personalizada ? " y por eso hemos reservado" : "."}
        </p>

        {
          personalizada && (
            <Fragment>
              {/* Pases reservados */}
              <div class="bloque-pases inline-flex items-center gap-2 rounded-full border border-[#c98d88]/60 px-5 py-1.5 mt-2">
                <span
                  id="numero-pases"
                  class="font-crimson text-[24px] font-semibold leading-none text-[#a35f5a]"
                >
                  {pases}
                </span>
                <span
                  id="etiqueta-pases"
                  class="font-cormorant text-sm uppercase tracking-[0.2em] leading-none text-[#122a4d]"
                >
                  {etiquetaPases}
                </span>
              </div>

              <p class="bloque-pases font-cormorant italic text-[17px] text-[#122a4d] mt-1.5 mb-4">
                en tu honor
              </p>
            </Fragment>
          )
        }

        <!-- Línea -->
        <div class="linea-deco w-14 h-[1px] bg-[#c98d88]/60 mx-auto mb-2"></div>

        <!-- Fecha -->
        <p
          class="texto-fecha font-cormorant text-sm tracking-[0.2em] text-[#122a4d] uppercase mb-0"
        >
          a realizarse el dia
        </p>
        <p
          class="texto-fecha font-cormorant text-lg tracking-[0.25em] font-semibold text-[#a35f5a] uppercase mb-0"
        >
          Sábado
        </p>
        <div class="bloque-fecha flex flex-col items-center mt-1 gap-1">
          <div class="flex items-center justify-center gap-2 w-full">
            <div class="flex-1 h-[1px] bg-[#c98d88]"></div>
            <span class="text-[#c98d88] text-xs">✦</span>
            <div class="flex-1 h-[1px] bg-[#c98d88]"></div>
          </div>
          <span class="font-crimson text-[1.2rem] tracking-[0.3em] text-[#122a4d] font-semibold">05|09|2026</span>
          <div class="flex items-center justify-center gap-2 w-full">
            <div class="flex-1 h-[1px] bg-[#c98d88]"></div>
            <span class="text-[#c98d88] text-xs">✦</span>
            <div class="flex-1 h-[1px] bg-[#c98d88]"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Fotos polaroid -->
    <div class="fotos-wrapper flex justify-center items-start gap-1 -mt-16 px-2 relative z-20">
      <!-- Foto 1 - inclinada a la izquierda -->
      <div class="foto-1 flex-shrink-0 drop-shadow-xl flex flex-col items-center relative">
        <img
          src="/imagenes/hojaslateral.png"
          alt="Hojas decorativas"
          class="hojas-deco w-[100px] object-contain absolute -top-20 -left-8 z-10"
        />
        <img
          src="/imagenes/foto2.png"
          alt="Foto 1"
          class="w-[175px] h-[215px] object-contain block relative z-20"
        />
      </div>

      <!-- Foto 2 - inclinada a la derecha, levemente más abajo -->
      <div
        class="foto-2 flex-shrink-0 mt-16 -ml-16 drop-shadow-xl relative z-20"
      >
        <img
          src="/imagenes/foto3.png"
          alt="Foto 2"
          class="w-[175px] h-[215px] object-contain block"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const ease = "power3.out";

  // Sobre
  gsap.fromTo(".sobre-img",
    { opacity: 0, y: -50 },
    { opacity: 1, y: 0, duration: 1.4, ease,
      scrollTrigger: { trigger: ".sobre-img", start: "top 88%", toggleActions: "play none none reset" }
    }
  );

  // Card
  gsap.fromTo(".card-wrapper",
    { opacity: 0, y: 50, scale: 0.96 },
    { opacity: 1, y: 0, scale: 1, duration: 1.2, ease,
      scrollTrigger: { trigger: ".card-wrapper", start: "top 85%", toggleActions: "play none none reset" }
    }
  );

  // Sello
  gsap.fromTo(".sello-img",
    { opacity: 0, scale: 0, rotation: -30 },
    { opacity: 1, scale: 1, rotation: 0, duration: 1, ease: "back.out(2.5)", delay: 0.3,
      scrollTrigger: { trigger: ".card-wrapper", start: "top 85%", toggleActions: "play none none reset" }
    }
  );

  // Líneas decorativas
  gsap.fromTo(".linea-deco",
    { opacity: 0, scaleX: 0 },
    { opacity: 1, scaleX: 1, duration: 0.7, stagger: 0.2, ease,
      scrollTrigger: { trigger: ".linea-deco", start: "top 90%", toggleActions: "play none none reset" }
    }
  );

  // Texto invitación
  gsap.fromTo(".texto-invitacion",
    { opacity: 0, y: 16, filter: "blur(4px)" },
    { opacity: 1, y: 0, filter: "blur(0px)", duration: 1, ease,
      scrollTrigger: { trigger: ".texto-invitacion", start: "top 88%", toggleActions: "play none none reset" }
    }
  );

  // Pases reservados — ausentes en la invitación genérica
  if (document.querySelector(".bloque-pases")) {
    gsap.fromTo(".bloque-pases",
      { opacity: 0, scale: 0.85 },
      { opacity: 1, scale: 1, duration: 0.8, stagger: 0.15, ease: "back.out(1.6)",
        scrollTrigger: { trigger: ".bloque-pases", start: "top 90%", toggleActions: "play none none reset" }
      }
    );
  }

  // Bloque del invitado — ausente en la invitación genérica
  if (document.querySelector(".bloque-invitado")) {
    gsap.fromTo(".bloque-invitado",
      { opacity: 0, y: 18 },
      { opacity: 1, y: 0, duration: 0.9, stagger: 0.12, ease,
        scrollTrigger: { trigger: ".bloque-invitado", start: "top 88%", toggleActions: "play none none reset" }
      }
    );
  }

  // ═══ Personalización por URL: ?invitado=Ana%20Perez&pases=2 ═══
  const params = new URLSearchParams(window.location.search);
  const invitadoUrl = params.get("invitado") ?? params.get("nombre");
  const pasesUrl = params.get("pases");

  const elNombre = document.getElementById("nombre-invitado");
  if (elNombre && invitadoUrl) elNombre.textContent = invitadoUrl.trim();

  if (pasesUrl) {
    const n = parseInt(pasesUrl, 10);
    if (Number.isFinite(n) && n > 0) {
      const elNum = document.getElementById("numero-pases");
      const elTxt = document.getElementById("etiqueta-pases");
      if (elNum) elNum.textContent = String(n);
      if (elTxt) elTxt.textContent = n === 1 ? "pase" : "pases";
    }
  }

  // El nombre SIEMPRE en una sola línea: se mide y se encoge hasta entrar
  function ajustarNombre() {
    if (!elNombre) return;
    const MAX = 30;
    const MIN = 14;
    let px = MAX;
    elNombre.style.fontSize = px + "px";
    while (elNombre.scrollWidth > elNombre.clientWidth && px > MIN) {
      px -= 0.5;
      elNombre.style.fontSize = px + "px";
    }
  }

  // Great Vibes es webfont: medir antes de que cargue da un ancho falso
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(ajustarNombre);
  } else {
    ajustarNombre();
  }
  window.addEventListener("resize", ajustarNombre, { passive: true });

  // Texto fecha
  gsap.fromTo(".texto-fecha",
    { opacity: 0, y: 14 },
    { opacity: 1, y: 0, duration: 0.8, stagger: 0.15, ease,
      scrollTrigger: { trigger: ".texto-fecha", start: "top 90%", toggleActions: "play none none reset" }
    }
  );

  // Bloque fecha
  gsap.fromTo(".bloque-fecha",
    { opacity: 0, scale: 0.9 },
    { opacity: 1, scale: 1, duration: 0.9, ease: "back.out(1.5)", delay: 0.3,
      scrollTrigger: { trigger: ".bloque-fecha", start: "top 90%", toggleActions: "play none none reset" }
    }
  );

  // Fotos polaroid
  gsap.fromTo(".foto-1",
    { opacity: 0, x: -50, rotation: -4 },
    { opacity: 1, x: 0, rotation: 0, duration: 1.2, ease,
      scrollTrigger: { trigger: ".fotos-wrapper", start: "top 90%", toggleActions: "play none none reset" }
    }
  );

  gsap.fromTo(".foto-2",
    { opacity: 0, x: 50, rotation: 4 },
    { opacity: 1, x: 0, rotation: 0, duration: 1.2, ease, delay: 0.2,
      scrollTrigger: { trigger: ".fotos-wrapper", start: "top 90%", toggleActions: "play none none reset" }
    }
  );

  // Hojas: salen de abajo una vez que foto-1 termina (~1.2s)
  gsap.fromTo(".hojas-deco",
    { opacity: 0, y: 60 },
    { opacity: 1, y: 0, duration: 1.3, ease: "power2.out", delay: 0.5,
      scrollTrigger: { trigger: ".fotos-wrapper", start: "top 90%", toggleActions: "play none none reset" }
    }
  );
</script>
