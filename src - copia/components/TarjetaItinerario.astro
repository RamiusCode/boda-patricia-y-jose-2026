---
const eventos = [
  { hora: "16:00", texto: "Ceremonia",                icono: "/iconos/anillo-de-bodas.png", lado: "izq" },
  { hora: "17:00", texto: "Brindis y baile de novios", icono: "/iconos/brindis.png",        lado: "der" },
  { hora: "18:00", texto: "Bocaditos y baile",        icono: "/iconos/bocaditos.png",       lado: "izq" },
  { hora: "19:00", texto: "Cena",                     icono: "/iconos/cena.png",            lado: "der" },
  { hora: "20:00", texto: "Fiesta y baile",           icono: "/iconos/musica.png",          lado: "izq" },
  { hora: "22:00", texto: "Torta",                    icono: "/iconos/torta.png",           lado: "der" },
];
---

<div class="tarjeta-itinerario w-full">
  <div class="fondo-palorosa shadow-xl overflow-hidden">
    <div class="px-3 py-5">

      <!-- Título -->
      <div class="flex items-center gap-2 mb-3">
        <div class="flex-1 h-px bg-[#c98d88]"></div>
        <h2 class="font-cormorant text-lg text-[#122a4d] uppercase font-semibold px-2">Itinerario</h2>
        <div class="flex-1 h-px bg-[#c98d88]"></div>
      </div>

      <!-- Timeline -->
      <div class="relative px-2">

        <!-- Línea central vertical -->
        <div class="absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-[1.5px] bg-[#c98d88]/60"></div>

        <div class="flex flex-col gap-0">
          {eventos.map((e, i) => (
            <div>

              <!-- Evento -->
              <div class="flex items-center py-1 relative z-10 gap-1">
                {e.lado === "izq" ? (
                  <>
                    <div class="flex flex-col items-center justify-center w-[40%]">
                      <img src={e.icono} alt={e.texto} class="w-7 h-7 object-contain azul-filter" />
                    </div>
                    <div class="flex items-center justify-center flex-1">
                      <div class="w-2 h-2 rounded-full bg-[#c98d88] border border-[#a35f5a]/50"></div>
                    </div>
                    <div class="flex flex-col items-center justify-center text-center w-[40%]">
                      <p class="font-cormorant text-xs text-[#122a4d] font-semibold leading-tight">{e.texto}</p>
                      <p class="font-crimson text-sm text-[#a35f5a] font-semibold">{e.hora}</p>
                    </div>
                  </>
                ) : (
                  <>
                    <div class="flex flex-col items-center justify-center text-center w-[40%]">
                      <p class="font-cormorant text-xs text-[#122a4d] font-semibold leading-tight">{e.texto}</p>
                      <p class="font-crimson text-sm text-[#a35f5a] font-semibold">{e.hora}</p>
                    </div>
                    <div class="flex items-center justify-center flex-1">
                      <div class="w-2 h-2 rounded-full bg-[#c98d88] border border-[#a35f5a]/50"></div>
                    </div>
                    <div class="flex flex-col items-center justify-center w-[40%]">
                      <img src={e.icono} alt={e.texto} class="w-7 h-7 object-contain azul-filter" />
                    </div>
                  </>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .azul-filter {
    filter: brightness(0) saturate(100%) invert(13%) sepia(76%) saturate(684%) hue-rotate(180deg) brightness(100%) contrast(98%);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  gsap.fromTo(".tarjeta-itinerario",
    { opacity: 0, y: 40 },
    { opacity: 1, y: 0, duration: 1, ease: "power3.out",
      scrollTrigger: { trigger: ".tarjeta-itinerario", start: "top 90%", toggleActions: "play none none reset" }
    }
  );
</script>
